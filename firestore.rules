rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validItem(d) {
      return d.keys().hasOnly(['artikel', 'menge', 'name', 'erstelltAm', 'erledigt', 'erledigtVon', 'erledigtAm'])
        && d.artikel is string && d.artikel.size() > 0 && d.artikel.size() <= 80
        && d.menge is string && d.menge.size() <= 30
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.erledigt is bool
        && d.erledigtVon is string && d.erledigtVon.size() <= 30;
    }

    // Jede Familie hat einen geheimen Code. Zugriff nur, wer ihn kennt:
    // Für "listen" selbst gibt es keine Regel, also kann niemand die Codes auflisten.
    match /listen/{code}/items/{id} {
      allow read, delete: if request.auth != null && code.size() >= 20;
      allow create: if request.auth != null && code.size() >= 20
        && validItem(request.resource.data)
        && request.resource.data.erstelltAm == request.time;
      allow update: if request.auth != null && code.size() >= 20
        && validItem(request.resource.data)
        && request.resource.data.erstelltAm == resource.data.erstelltAm;
    }
  }
}
